<mujoco model="scene">
  <include file="so101.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <camera name="top_cam" pos="0.20 0 0.65" quat="1 0 0 0" fovy="60"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"/>
    <!-- Cube to grab -->
    <body name="cube" pos="0.25 0 0.025">
        <freejoint name="cube_free"/>
        <geom name="cube_geom"
              type="box"
              size="0.025 0.025 0.025"
              mass="0.05"
              rgba="0.9 0.1 0.1 1"
              friction="2.0 0.05 0.001"
              condim="4"
              contype="1"
              conaffinity="1"/>
    </body>

    <!-- Box -->
    <body name="dropoff_box" pos="0.36 -0.20 0">
        <!-- Bottom -->
        <geom
            name="box_bottom"
            type="box"
            pos="0 0 0.006"
            size="0.065 0.065 0.006"
            rgba="0.2 0.5 0.9 1"
        />
        <!-- Left wall -->
        <geom
            name="box_left"
            type="box"
            pos="-0.065 0 0.04"
            size="0.005 0.065 0.04"
            rgba="0.2 0.5 0.9 1"
        />
        <!-- Right wall -->
        <geom
            name="box_right"
            type="box"
            pos="0.065 0 0.04"
            size="0.005 0.065 0.04"
            rgba="0.2 0.5 0.9 1"
        />
        <!-- Front wall -->
        <geom
            name="box_front"
            type="box"
            pos="0 0.065 0.04"
            size="0.065 0.005 0.04"
            rgba="0.2 0.5 0.9 1"
        />
        <!-- Back wall -->
        <geom
            name="box_back"
            type="box"
            pos="0 -0.065 0.04"
            size="0.065 0.005 0.04"
            rgba="0.2 0.5 0.9 1"
        />
    </body>
  </worldbody>
</mujoco>
